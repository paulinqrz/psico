generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./clinica.db"
}

model Paciente {
  id             String   @id @default(uuid())
  nome           String
  dataNascimento DateTime
  telefone       String?
  email          String?
  cpf            String?
  endereco       String?
  profissao      String?
  queixa         String?
  historico      String?
  createdAt      DateTime @default(now())
  sessoes        Sessao[]
}

model Sessao {
  id          String   @id @default(uuid())
  pacienteId  String
  dataSessao  DateTime @default(now())
  resumo      String?
  anotacoes   String?
  createdAt   DateTime @default(now())
  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
}
